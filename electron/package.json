{
  "name": "farm-accounting-desktop",
  "version": "1.0.0",
  "description": "نظام الحسابات والإدارة المالية لمزرعة المواشي — تطبيق سطح المكتب",
  "main": "electron/src/main.js",
  "scripts": {
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:desktop": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win --x64",
    "electron": "electron .",
    "test": "node --test test/auth.test.js test/login-security.test.js"
  },
  "build": {
    "appId": "com.farmaccounting.desktop",
    "productName": "Farm Accounting",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "electron/assets",
        "to": "assets"
      }
    ]
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
